
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scanty-ai-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
